#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
prefix="${OMACAP_PREFIX:-$HOME/.local}"
build_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omacap/build"

if ! command -v omarchy-pkg-add >/dev/null; then
  printf 'install-omarchy: omarchy-pkg-add is unavailable; this installer requires Omarchy\n' >&2
  exit 1
fi

omarchy-pkg-add \
  base-devel cmake ninja pkgconf qt6-base layer-shell-qt \
  wayland wayland-protocols libdeflate wl-clipboard xdg-utils \
  tesseract tesseract-data-eng

cmake -S "$repo_dir" -B "$build_dir" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="$prefix"
cmake --build "$build_dir" --parallel
cmake --install "$build_dir"

"$prefix/bin/omacap" --version
